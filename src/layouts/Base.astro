---
import '../styles/global.css';
import { SITE, SITE_NAME, getSurahs, surahUrl, popularName } from '../lib/quran';
import { COLLECTIONS } from '../lib/collections';

export interface Crumb {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  path: string;
  canonical?: string;
  noindex?: boolean;
  crumbs?: Crumb[];
  jsonLd?: Record<string, unknown>[];
  urduFont?: boolean;
  ogType?: string;
}

const { title, description, path, canonical = path, noindex = false, crumbs = [], jsonLd = [], urduFont = false, ogType = 'website' } = Astro.props;
const canonicalUrl = SITE + (canonical === '/' ? '/' : canonical);
const ogImage = 'https://raw.githubusercontent.com/The-Quran-Project/Quran-Audio/main/banner.png';

const fonts = [
  'family=Inter:wght@400;500;600;700;800',
  'family=Scheherazade+New:wght@400;700',
  urduFont && 'family=Noto+Nastaliq+Urdu:wght@400;600',
].filter(Boolean).join('&');

const schema = [
  ...jsonLd,
  ...(crumbs.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [{ name: 'Home', url: '/' }, ...crumbs].map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.name,
          item: SITE + (c.url === '/' ? '/' : c.url),
        })),
      }]
    : []),
];

const popular = [36, 67, 55, 56, 18, 73, 1, 2, 62, 48].map((n) => getSurahs()[n - 1]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="google-site-verification" content="V6jH53vmXBPCB3BYr14B5Ly3mPcXLqb6r7cpWCckA0s" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#10b981" />
    <link rel="icon" href="/quraan.png" type="image/png" />
    <link rel="manifest" href="/manifest.json" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`} />

    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <!-- Apply saved reader preferences before first paint to avoid a flash. -->
    <script is:inline>
      try {
        const p = JSON.parse(localStorage.getItem('nur_prefs') || '{}');
        const c = document.documentElement.classList;
        const dark = localStorage.getItem('theme');
        if (dark === 'dark' || (!dark && matchMedia('(prefers-color-scheme: dark)').matches)) c.add('dark');
        if (p.size) document.documentElement.style.setProperty('--arabic-size', p.size + 'rem');
        if (p.hideTranslit) c.add('hide-translit');
        if (p.hideTranslation) c.add('hide-translation');
        if (p.mushaf) c.add('mushaf');
      } catch (e) {}
    </script>
  </head>
  <body class="flex min-h-screen flex-col font-sans">
    <header class="sticky top-0 z-40 border-b border-slate-200/60 bg-paper/95 backdrop-blur dark:border-slate-800/60 dark:bg-ink/95">
      <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4" aria-label="Main">
        <a href="/" class="flex items-center gap-3 font-extrabold tracking-tight">
          <img src="/quraan.png" alt="" width="36" height="36" class="h-9 w-9 rounded-xl" />
          <span class="text-lg">Nur al-Quran</span>
        </a>
        <div class="flex items-center gap-1 text-sm font-semibold">
          <a href="/#surahs" class="hidden rounded-lg px-3 py-2 hover:bg-slate-100 sm:block dark:hover:bg-slate-800">Surahs</a>
          <a href="/para" class="hidden rounded-lg px-3 py-2 hover:bg-slate-100 sm:block dark:hover:bg-slate-800">Para</a>
          <a href="/bookmarks" class="rounded-lg px-3 py-2 hover:bg-slate-100 dark:hover:bg-slate-800">Bookmarks</a>
          <button type="button" id="settings-toggle" class="rounded-lg px-3 py-2 hover:bg-slate-100 dark:hover:bg-slate-800" aria-expanded="false" aria-controls="settings">Settings</button>
        </div>
      </nav>
      <div id="settings" hidden class="mx-auto max-w-6xl px-4 pb-4">
        <div class="ml-auto grid max-w-sm gap-4 rounded-2xl border border-slate-200 bg-white p-5 text-sm shadow-xl dark:border-slate-800 dark:bg-slate-900">
          <label class="flex items-center justify-between gap-4">Dark mode <input type="checkbox" data-pref="dark" /></label>
          <label class="flex items-center justify-between gap-4">Show transliteration <input type="checkbox" data-pref="translit" /></label>
          <label class="flex items-center justify-between gap-4">Show translation <input type="checkbox" data-pref="translation" /></label>
          <label class="flex items-center justify-between gap-4">Mushaf mode (Arabic only) <input type="checkbox" data-pref="mushaf" /></label>
          <label class="grid gap-2">Arabic size <input type="range" min="1.4" max="3.6" step="0.1" data-pref="size" /></label>
        </div>
      </div>
    </header>

    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="no-print mx-auto w-full max-w-6xl px-4 pt-4 text-xs text-slate-500">
        <ol class="flex flex-wrap items-center gap-1">
          <li><a href="/" class="hover:text-emerald-600">Home</a></li>
          {crumbs.map((c, i) => (
            <li class="flex items-center gap-1">
              <span aria-hidden="true">/</span>
              {i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.url} class="hover:text-emerald-600">{c.name}</a>}
            </li>
          ))}
        </ol>
      </nav>
    )}

    <main class="flex-1 pb-32">
      <slot />
    </main>

    <footer class="border-t border-slate-200 bg-white/60 dark:border-slate-800 dark:bg-slate-900/40">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 text-sm sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <h2 class="mb-3 font-bold">Popular Surahs</h2>
          <ul class="space-y-1.5 text-slate-600 dark:text-slate-400">
            {popular.map((s) => <li><a href={surahUrl(s)} class="hover:text-emerald-600">Surah {popularName(s)}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="mb-3 font-bold">Read by Para</h2>
          <ul class="grid grid-cols-5 gap-1.5 text-slate-600 dark:text-slate-400">
            {Array.from({ length: 30 }, (_, i) => <li><a href={`/para/${i + 1}`} class="hover:text-emerald-600">{i + 1}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="mb-3 font-bold">Collections</h2>
          <ul class="space-y-1.5 text-slate-600 dark:text-slate-400">
            {COLLECTIONS.map((c) => <li><a href={`/${c.slug}`} class="hover:text-emerald-600">{c.short}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="mb-3 font-bold">Nur al-Quran</h2>
          <ul class="space-y-1.5 text-slate-600 dark:text-slate-400">
            <li><a href="/about" class="hover:text-emerald-600">About & Sources</a></li>
            <li><a href="/donate" class="hover:text-emerald-600">Donate</a></li>
          </ul>
          <p class="mt-4 text-xs leading-relaxed text-slate-500">
            Arabic text: Tanzil (Uthmani). Translations: Saheeh International, Fateh Muhammad Jalandhry, Muhiuddin Khan. Tafsir: Ibn Kathir, Ma'ariful Qur'an, Tazkirul Quran.
          </p>
        </div>
      </div>
    </footer>

    <div id="player" hidden class="fixed inset-x-0 bottom-0 z-50 p-3">
      <div class="mx-auto flex max-w-3xl items-center gap-3 rounded-2xl border border-slate-200 bg-white p-3 shadow-2xl dark:border-slate-800 dark:bg-slate-900">
        <button type="button" data-player="toggle" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-emerald-600 font-bold text-white" aria-label="Play or pause">▶</button>
        <div class="min-w-0 flex-1">
          <p data-player="title" class="truncate text-sm font-bold"></p>
          <p data-player="sub" class="truncate text-xs text-emerald-700 dark:text-emerald-400"></p>
          <input data-player="seek" type="range" min="0" value="0" step="0.1" class="mt-1 w-full accent-emerald-600" aria-label="Seek" />
        </div>
        <button type="button" data-player="prev" class="px-2 text-lg" aria-label="Previous verse">⏮</button>
        <button type="button" data-player="next" class="px-2 text-lg" aria-label="Next verse">⏭</button>
        <button type="button" data-player="close" class="px-2 text-lg text-slate-400" aria-label="Close player">✕</button>
      </div>
      <audio data-player="audio" preload="none"></audio>
    </div>

    <script>
      import '../scripts/settings';
      import '../scripts/player';
      import '../scripts/bookmarks';
    </script>
  </body>
</html>
