---
import Base from '../layouts/Base.astro';
import AyahBlock from '../components/AyahBlock.astro';
import { SITE, getSurah, getTafsir, popularName, surahUrl, ayahUrl } from '../lib/quran';
import { COLLECTIONS, type Collection } from '../lib/collections';

export function getStaticPaths() {
  return COLLECTIONS.map((collection) => ({ params: { collection: collection.slug }, props: { collection } }));
}

interface Props {
  collection: Collection;
}

const { collection: c } = Astro.props;
const path = `/${c.slug}`;
const passages = c.passages.map((p) => {
  const s = getSurah(p.surah);
  return { s, ayahs: s.ayahs.slice(p.from - 1, Math.min(p.to, s.ayahCount)) };
});
const totalAyahs = passages.reduce((n, p) => n + p.ayahs.length, 0);

// Single-verse pages (Ayatul Kursi) are the canonical home of that verse, so they carry its tafsir too.
const tafsir = totalAyahs <= 2 ? passages.flatMap((p) => p.ayahs.map((a) => ({ a, s: p.s, entries: getTafsir(a.surah, a.number).filter((t) => t.owned) }))) : [];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: c.h1,
    url: SITE + path,
    inLanguage: ['ar', 'en', 'ur'],
    isPartOf: { '@type': 'Book', name: 'The Holy Quran', inLanguage: 'ar' },
    hasPart: passages.map((p) => ({ '@type': 'Chapter', name: `Surah ${popularName(p.s)}`, url: SITE + surahUrl(p.s) })),
  },
];
---

<Base title={c.title} description={c.description} path={path} crumbs={[{ name: c.short, url: path }]} jsonLd={jsonLd} urduFont ogType="article">
  <div class="mx-auto max-w-4xl px-4">
    <header class="py-10 text-center">
      {c.arabicTitle && <p class="arabic text-[2.4rem] font-bold text-emerald-800 dark:text-emerald-300" lang="ar">{c.arabicTitle}</p>}
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">{c.h1}</h1>
      <p class="mt-3 text-sm text-slate-500">{totalAyahs} ayat from {new Set(passages.map((p) => p.s.number)).size} {passages.length === 1 ? 'surah' : 'surahs'}</p>
      <div class="no-print mt-6 flex flex-wrap justify-center gap-2 text-sm font-semibold">
        <button type="button" data-play-all class="rounded-full bg-emerald-600 px-5 py-2.5 text-white hover:bg-emerald-700">▶ Listen</button>
        <button type="button" onclick="window.print()" class="rounded-full border border-slate-200 px-5 py-2.5 hover:border-emerald-500 dark:border-slate-700">Print / Save PDF</button>
      </div>
    </header>

    <div class="mx-auto max-w-3xl space-y-3 text-center leading-relaxed text-slate-600 dark:text-slate-400">
      {c.intro.map((p) => <p>{p}</p>)}
    </div>

    {passages.map(({ s, ayahs }) => (
      <section class="mt-12">
        <h2 class="border-b-2 border-emerald-600/20 pb-3 text-xl font-extrabold tracking-tight">
          <a href={surahUrl(s)} class="hover:text-emerald-700">Surah {popularName(s)}</a>
          <span class="ml-2 text-base font-normal text-slate-500">
            {ayahs.length === s.ayahCount ? `${s.ayahCount} ayat` : ayahs.length === 1 ? `ayah ${ayahs[0].number}` : `ayat ${ayahs[0].number}–${ayahs[ayahs.length - 1].number}`}
          </span>
        </h2>
        {ayahs[0].number === 1 && s.number !== 1 && s.number !== 9 && (
          <p class="arabic mt-6 text-center" lang="ar">بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ</p>
        )}
        <div class="ayah-list">
          {ayahs.map((a) => <AyahBlock ayah={a} surah={s} langs={['english', 'urdu']} showSurah />)}
        </div>
      </section>
    ))}

    {tafsir.map(({ a, s, entries }) => entries.length > 0 && (
      <section class="mt-14">
        <h2 class="text-2xl font-extrabold tracking-tight">Tafsir of {popularName(s)} {a.surah}:{a.number}</h2>
        {entries.map((t) => (
          <article class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
            <h3 class="text-lg font-bold">{t.author}</h3>
            <div class="prose-tafsir mt-3 text-slate-700 dark:text-slate-300" set:html={t.html} />
          </article>
        ))}
        <p class="mt-4 text-sm"><a href={ayahUrl(s, a.number)} class="text-emerald-700 underline dark:text-emerald-400">Bangla translation and verse details for {a.surah}:{a.number}</a></p>
      </section>
    ))}

    <nav class="no-print mt-16" aria-label="More collections">
      <h2 class="mb-3 text-lg font-bold">More to read</h2>
      <ul class="flex flex-wrap gap-2 text-sm">
        {COLLECTIONS.filter((o) => o.slug !== c.slug).map((o) => (
          <li><a href={`/${o.slug}`} class="block rounded-full border border-slate-200 px-4 py-2 hover:border-emerald-500 dark:border-slate-700">{o.short}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</Base>
