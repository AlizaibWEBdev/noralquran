---
import Base from '../../../layouts/Base.astro';
import AyahBlock from '../../../components/AyahBlock.astro';
import Facts from '../../../components/Facts.astro';
import { SITE, fitTitle, getSurahs, getSurah, getTafsir, isAyahIndexable, ayahUrl, paraUrl, surahTitle, surahUrl, popularName, truncate, type Ayah, type Surah, type VerseRef } from '../../../lib/quran';
import { PARA_NAMES } from '../../../lib/names';
import { CANONICAL_OVERRIDES } from '../../../lib/collections';

export function getStaticPaths() {
  return getSurahs().flatMap((surah) =>
    surah.ayahs.map((ayah) => ({ params: { slug: surah.slug, n: String(ayah.number) }, props: { surah, ayah } })),
  );
}

interface Props {
  surah: Surah;
  ayah: Ayah;
}

const { surah: s, ayah: a } = Astro.props;
const key = `${s.number}:${a.number}`;
const path = ayahUrl(s, a.number);
const canonical = CANONICAL_OVERRIDES[key] ?? path;
const tafsir = getTafsir(s.number, a.number);
const indexable = isAyahIndexable(s.number, a.number) && canonical === path;

const prev = a.number > 1 ? { s, n: a.number - 1 } : s.number > 1 ? { s: getSurah(s.number - 1), n: getSurah(s.number - 1).ayahCount } : null;
const next = a.number < s.ayahCount ? { s, n: a.number + 1 } : s.number < 114 ? { s: getSurah(s.number + 1), n: 1 } : null;

const title = fitTitle(`${surahTitle(s)} Ayat ${a.number} (${key})`, ['Translation, Tafsir & Audio', 'Translation & Tafsir', 'Tafsir']);
const description = `${surahTitle(s)} ayah ${a.number}: "${truncate(a.english, 110)}" Read ${key} in Arabic with English, Urdu and Bangla translation, transliteration and tafsir.`;
const rangeText = ({ from, to }: { from: VerseRef; to: VerseRef }) =>
  from.surah === to.surah ? `${from.surah}:${from.ayah}–${to.ayah}` : `${from.surah}:${from.ayah}–${to.surah}:${to.ayah}`;
const groupStart = ({ from }: { from: VerseRef }) => `${ayahUrl(getSurah(from.surah), from.ayah)}#tafsir`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: `${surahTitle(s)} ${key}`,
    position: a.number,
    inLanguage: 'ar',
    text: a.arabic,
    url: SITE + canonical,
    isPartOf: { '@type': 'Chapter', name: `${surahTitle(s)} (${s.arabicName})`, url: SITE + surahUrl(s) },
    workTranslation: [
      { '@type': 'CreativeWork', inLanguage: 'en', text: a.english },
      { '@type': 'CreativeWork', inLanguage: 'ur', text: a.urdu },
    ],
  },
];
---

<Base
  title={title}
  description={description}
  path={path}
  canonical={canonical}
  noindex={!indexable}
  crumbs={[{ name: surahTitle(s), url: surahUrl(s) }, { name: `Ayah ${a.number}`, url: path }]}
  jsonLd={jsonLd}
  urduFont
  ogType="article"
>
  <div class="mx-auto max-w-4xl px-4">
    <header class="py-8">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{surahTitle(s)} Ayat {a.number}</h1>
      <p class="mt-2 text-sm text-slate-500">
        Verse {key} · Para {a.juz} ({PARA_NAMES[a.juz - 1].name}) · Page {a.page}
      </p>
    </header>

    <AyahBlock ayah={a} surah={s} langs={['english', 'urdu', 'bangla']} link={false} />

    <section class="mt-8">
      <Facts
        rows={[
          ['Surah', [{ text: `${s.number}. ${popularName(s)}`, href: surahUrl(s) }]],
          ['Ayah', `${a.number} of ${s.ayahCount}`],
          ['Para (juz)', [{ text: `Para ${a.juz}`, href: paraUrl(a.juz) }]],
          ['Mushaf page', String(a.page)],
          ['Ruku', `${a.ruku} (of the whole Quran)`],
          ['Manzil', String(a.manzil)],
        ]}
      />
    </section>

    <section id="tafsir" class="mt-14 scroll-mt-24">
      <h2 class="text-2xl font-extrabold tracking-tight">Tafsir of {surahTitle(s)} Ayah {a.number}</h2>
      {tafsir.length === 0 && (
        <p class="mt-4 text-slate-600 dark:text-slate-400">
          Commentary for this verse is not available yet. <a href={`${surahUrl(s)}#ayah-${a.number}`} class="text-emerald-700 underline dark:text-emerald-400">Read it in context</a> within {surahTitle(s)}.
        </p>
      )}
      {tafsir.map((t) => (
        <article class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
          <h3 class="text-lg font-bold">{t.author}{t.group && <span class="ml-2 text-sm font-normal text-slate-500">on {rangeText(t.group)}</span>}</h3>
          {t.owned
            ? <div class="prose-tafsir mt-3 text-slate-700 dark:text-slate-300" set:html={t.html} />
            : <p class="mt-3 text-slate-600 dark:text-slate-400">
                {t.author} explains ayat {rangeText(t.group!)} together.{' '}
                <a href={groupStart(t.group!)} class="font-semibold text-emerald-700 underline dark:text-emerald-400">Read the commentary on {rangeText(t.group!)}</a>.
              </p>}
        </article>
      ))}
    </section>

    <nav class="no-print mt-14 grid gap-3 sm:grid-cols-3" aria-label="Verse navigation">
      {prev ? (
        <a href={ayahUrl(prev.s, prev.n)} class="rounded-2xl border border-slate-200 p-4 hover:border-emerald-500 dark:border-slate-800">
          <span class="text-xs text-slate-500">← Previous</span>
          <span class="mt-1 block font-bold">{popularName(prev.s)} {prev.s.number}:{prev.n}</span>
        </a>
      ) : <span />}
      <a href={`${surahUrl(s)}#ayah-${a.number}`} class="rounded-2xl border border-slate-200 p-4 text-center hover:border-emerald-500 dark:border-slate-800">
        <span class="text-xs text-slate-500">Read in context</span>
        <span class="mt-1 block font-bold">Full {surahTitle(s)}</span>
      </a>
      {next && (
        <a href={ayahUrl(next.s, next.n)} class="rounded-2xl border border-slate-200 p-4 text-right hover:border-emerald-500 dark:border-slate-800">
          <span class="text-xs text-slate-500">Next →</span>
          <span class="mt-1 block font-bold">{popularName(next.s)} {next.s.number}:{next.n}</span>
        </a>
      )}
    </nav>
  </div>
</Base>
