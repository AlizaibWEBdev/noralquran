---
import Base from '../../layouts/Base.astro';
import { getParas, getSurah, paraUrl, popularName } from '../../lib/quran';

const paras = getParas();
---

<Base
  title="Quran Para 1 to 30 – Read All 30 Paras (Juz) Online"
  description="Read all 30 paras (juz / sipara) of the Quran online, from Para 1 Alif Lam Meem to Para 30 Amma Yatasa'aloon, with Arabic text, English and Urdu translation and audio."
  path="/para"
  crumbs={[{ name: 'Para', url: '/para' }]}
>
  <div class="mx-auto max-w-6xl px-4">
    <header class="py-10">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Quran Para 1 to 30</h1>
      <p class="mt-3 max-w-3xl leading-relaxed text-slate-600 dark:text-slate-400">
        The Quran is divided into 30 paras (also called juz or sipara) of roughly equal length, which makes it easy to complete in a month –
        one para a day in Ramadan. Each para below opens with Arabic text, Urdu and English translation and verse-by-verse audio.
      </p>
    </header>
    <ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {paras.map((p) => {
        const a = p.ayahs[0];
        return (
          <li>
            <a href={paraUrl(p.number)} class="flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-4 hover:border-emerald-500 dark:border-slate-800 dark:bg-slate-900">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-emerald-600/10 font-bold text-emerald-800 dark:text-emerald-300">{p.number}</span>
              <span class="min-w-0 flex-1">
                <span class="block font-bold">Para {p.number}: {p.name}</span>
                <span class="block truncate text-xs text-slate-500">Starts at {popularName(getSurah(a.surah))} {a.surah}:{a.number} · {p.ayahs.length} ayat</span>
              </span>
              <span class="arabic text-xl" lang="ar">{p.arabic}</span>
            </a>
          </li>
        );
      })}
    </ol>
  </div>
</Base>
