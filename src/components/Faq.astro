---
interface Props {
  title: string;
  items: { q: string; a: string }[];
}
const { title, items } = Astro.props;
---

<section class="mt-16">
  <h2 class="mb-4 text-2xl font-extrabold tracking-tight">{title}</h2>
  <div class="divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white dark:divide-slate-800 dark:border-slate-800 dark:bg-slate-900">
    {items.map((f) => (
      <details class="group p-5">
        <summary class="cursor-pointer list-none font-semibold marker:hidden">{f.q}</summary>
        <p class="mt-3 leading-relaxed text-slate-600 dark:text-slate-400">{f.a}</p>
      </details>
    ))}
  </div>
</section>
