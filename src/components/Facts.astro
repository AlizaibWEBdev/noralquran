---
interface Props {
  rows: [string, string | { text: string; href: string }[]][];
}
const { rows } = Astro.props;
---

<dl class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-slate-200 bg-slate-200 text-sm sm:grid-cols-3 dark:border-slate-800 dark:bg-slate-800">
  {rows.map(([k, v]) => (
    <div class="bg-white p-4 dark:bg-slate-900">
      <dt class="text-[11px] font-bold uppercase tracking-wider text-slate-500">{k}</dt>
      <dd class="mt-1 font-semibold">
        {typeof v === 'string'
          ? v
          : v.map((l, i) => <>{i > 0 && ', '}<a href={l.href} class="text-emerald-700 hover:underline dark:text-emerald-400">{l.text}</a></>)}
      </dd>
    </div>
  ))}
</dl>
